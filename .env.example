# ===========================================
# MATH RUSH - Variables de Entorno
# ===========================================
# Copia este archivo a .env y completa los valores
# cp .env.example .env
# ===========================================

# ===========================================
# SUPABASE (Requerido para producción)
# ===========================================
# Obtén estas variables de tu proyecto en Supabase Dashboard
# https://app.supabase.com

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ===========================================
# GOOGLE OAUTH (Opcional)
# ===========================================
# Configura en Supabase Dashboard > Authentication > Providers > Google
# NO colocar el Client Secret en el frontend

# GOOGLE_CLIENT_ID=tu-client-id
# GOOGLE_CLIENT_SECRET (solo en backend/Edge Functions)

# ===========================================
# PAGOS - CULQI (Opcional)
# ===========================================
# Solo configurar en backend (Edge Functions)
# NO colocar estas variables en el frontend

# CULQI_PUBLIC_KEY=pk_test_...
# CULQI_SECRET_KEY=sk_test_... (solo backend)
# CULQI_WEBHOOK_SECRET=... (solo backend)

# ===========================================
# APIs DE IA (Opcional)
# ===========================================
# Solo configurar en backend (Edge Functions)
# NO colocar estas variables en el frontend

# AI_PROVIDER_KEY=...
# AI_PROVIDER_URL=...

# ===========================================
# NOTAS IMPORTANTES
# ===========================================
# 1. NUNCA subas el archivo .env a GitHub
# 2. Solo las variables con prefijo VITE_ van al frontend
# 3. Las claves secretas solo van en Edge Functions
# 4. La aplicación funciona en modo demo sin estas variables
# ===========================================
